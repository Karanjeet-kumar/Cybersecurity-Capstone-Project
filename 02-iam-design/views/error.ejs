<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<% if (typeof user !== "undefined" && user) { %><%- include("partials/header", { user }) %><% } %>
<main class="container">
  <section class="panel error-panel">
    <div class="service-icon">⚠️</div><span class="eyebrow">REQUEST STATUS</span><h1><%= title %></h1>
    <p><%= message %></p>
    <a href="<%= user ? '/dashboard' : '/' %>" class="btn btn-primary">Continue</a>
  </section>
</main>
<%- include("partials/footer") %>
