<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<%- include("partials/header", { user }) %>
<main class="container">
  <span class="eyebrow">RESTRICTED AREA</span><h1>Administration Panel</h1>
  <section class="panel">
    <span class="status-pill">● Authorized</span><h2>Admin API response</h2><p><%= result.message %></p>
    <div class="code-panel"><pre><%= JSON.stringify(result, null, 2) %></pre></div>
    <span class="permission-tag">write:admin</span>
  </section>
</main>
<%- include("partials/footer") %>
