<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<%- include("partials/header", { user }) %>
<main class="container">
  <span class="eyebrow">PROTECTED SERVICE</span><h1>AI Chat API</h1>
  <section class="panel">
    <span class="status-pill">● HTTP <%= status %></span><h2>API response</h2><p><%= result.message %></p>
    <div class="code-panel"><pre><%= JSON.stringify(result, null, 2) %></pre></div>
    <span class="permission-tag">read:ai-data</span>
  </section>
</main>
<%- include("partials/footer") %>
